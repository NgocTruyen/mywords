# Environment variables for MyWords application

# Server configuration
PORT=3000
NODE_ENV=development

# Database path (optional, defaults to data/journal.db)
# DB_PATH=./data/journal.db

# JWT Secret - CHANGE THIS IN PRODUCTION!
# Generate a strong random string for production use
# Example: openssl rand -base64 32
JWT_SECRET=mywords-super-secret-jwt-key-change-this-in-production
